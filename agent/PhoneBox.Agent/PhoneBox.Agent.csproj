<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Windows build: tray icon, WinRT media session, Core Audio. Linux / macOS build: the same agent without WinForms;
       the platform parts live in Unix/. Build one with  dotnet publish -f net10.0 -r linux-x64  (or osx-arm64 …). -->
  <PropertyGroup>
    <!-- On Windows both builds are available; elsewhere only the cross-platform one (no Windows targeting packs needed). -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhoneBoxAgent</AssemblyName>
    <RootNamespace>PhoneBox.Agent</RootNamespace>
    <Product>PhoneBox</Product>
    <Company>PhoneBox</Company>
    <Description>PhoneBox desktop agent: feeds the PhoneBox Android desk panel over USB or Wi-Fi.</Description>
    <Version>0.9.4</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <!-- no console window; lives in the system tray -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>phonebox.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="NAudio" Version="3.3.0" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <OutputType>Exe</OutputType>
    <!-- English only: no ICU needed, so minimal distributions work out of the box -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <Compile Remove="Unix/**" />
  </ItemGroup>

  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="Tray.cs;JobObject.cs;AudioControl.cs;MediaMonitor.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.default.json" LogicalName="config.default.json" />
    <EmbeddedResource Include="config.default.linux.json" LogicalName="config.default.linux.json" />
    <EmbeddedResource Include="config.default.macos.json" LogicalName="config.default.macos.json" />
    <EmbeddedResource Include="phonebox.ico" LogicalName="phonebox.ico" />
    <EmbeddedResource Include="settings.html" LogicalName="settings.html" />
    <!-- web kiosk lite: the panel built for older browsers by tools/kiosk-lite -->
    <EmbeddedResource Include="kiosk-lite\*.*" LogicalName="kiosk-lite/%(Filename)%(Extension)" />
    <EmbeddedResource Include="widgets.json" LogicalName="widgets.json" />
    <EmbeddedResource Include="templates.json" LogicalName="templates.json" />
    <!-- the phone's panel, served at /panel/ for the live preview in the layout editor -->
    <EmbeddedResource Include="..\..\android\app\src\main\assets\www\*.*" LogicalName="www/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\android\app\src\main\assets\www\widgets\*.*" LogicalName="www/widgets/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhoneBox.Agent.Tests" />
  </ItemGroup>
</Project>
